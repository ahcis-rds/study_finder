<% content_for :head do %>
  <meta property="og:site_name" content="StudyFinder" />
  <meta property="og:title" content="<%= @study.brief_title %>" />
  <meta property="og:description" content="Learn more about this study with StudyFinder!" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="<%= study_url(study.id) %>" />
  <meta property="og:image" content="<%= asset_url('flag.jpg') %>" />
<% end %>
<div class="hide-on-print share-container">
  <a href="https://www.facebook.com/sharer/sharer.php?u=<%=CGI.escape(study_url(study.id))%>" target="_blank" class="btn btn-sm btn-sq btn-primary btn-primary-contrast"><i class="bi bi-facebook" alt="Share on Facebook"></i> Facebook</a>
  <a href="http://twitter.com/share?text=check%20out%20this%20study!&url=<%=CGI.escape(study_url(study.id))%>&hashtags=studyfinder" target="_blank" class="btn btn-sm btn-sq btn-primary btn-primary-contrast"><i class="bi bi-twitter-x share-icon" alt="Share on Twitter"></i> Twitter</a>
  <div class="btn btn-primary btn-sm btn-email-me btn-primary-contrast" data-bs-toggle="modal" data-bs-target="#email-me-modal" data-title="<%=study.display_title%>" data-trial-id="<%=study.id%>"><i class="bi bi-envelope"></i> Email</div>
  <%= link_to study_path(@study.id, format: "pdf"), class: 'btn btn-primary btn-sm btn-print btn-primary-contrast' do %>
    <i class="bi bi-save"></i> Download PDF
  <% end %>
</div>
