<div class="contact">
  <%= @system_info.faq_description.html_safe unless @system_info.faq_description.nil? %>
  <h1>Contact Us</h1>
  <div class="row">
    <div class="col-md-12 col-sm-12 col-lg-6">
      <p>Use this form to contact the StudyFinder team with general questions about participating in research.</p>
      <%= form_tag contact_index_path, method: :post do %>
        <div class="form-group">
          <label for="name" class="form-label">Your name <small class="text-muted">(required)</small></label>
          <%= text_field_tag 'name', params[:name], class: 'form-control' %>
        </div>
        <div class="form-group">
          <label for="email" class="form-label">Your email address <small class="text-muted">(required)</small></label>
          <%= text_field_tag 'email', params[:email], class: 'form-control' %>
        </div>
        <div class="form-group">
          <label for="message" class="form-label">How can we help? <small class="text-muted">(required)</small></label>
          <%= text_area_tag 'message', params[:message], class: 'form-control' %>
          <% if @system_info.captcha %>
            <label class="visually-hidden" for="g-recaptcha-response">Google Recaptcha</label>
            <div id="myself-captcha" name="myself-captcha" data-controller="recaptcha" data-recaptcha-site-key-value="<%= Recaptcha.configuration.site_key %>">
            </div>
          <% end %>
        </div>
        <%= submit_tag 'Contact Us', class: 'btn btn-school', onclick: "track('send', 'event', 'contact_us_submit', 'submit');" %>
      <% end %>
    </div>
    <div class="col-6 d-none d-md-block">
      <%= image_tag 'contact-us.jpg', class: 'bordered', alt: '' %>
    </div>
  </div>
</div>
